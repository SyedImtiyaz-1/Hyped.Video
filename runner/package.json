{
  "name": "runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/run-job.ts src/voice.ts src/reel.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --out-extension:.js=.mjs --external:@anthropic-ai/claude-agent-sdk",
    "measure": "tsx --env-file=../.env src/measure.ts",
    "typecheck": "tsc --noEmit",
    "dev:credits": "tsx --env-file=../.env src/dev-credits.ts",
    "voice-previews": "tsx --env-file=../.env src/voice-previews.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest",
    "@launchreel/core": "*",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@openai/codex": "^0.157.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "description": "Runs one brag-slim job inside a Cloudflare Sandbox container. Also hosts the local cost benchmark."
}
