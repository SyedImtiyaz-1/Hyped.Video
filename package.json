{
  "name": "launchreel",
  "private": true,
  "workspaces": [
    "packages/*",
    "runner",
    "render",
    "web"
  ],
  "scripts": {
    "db:push": "node --env-file-if-exists=.env node_modules/prisma/build/index.js db push --schema packages/core/prisma/schema.prisma",
    "db:generate": "node node_modules/prisma/build/index.js generate --schema packages/core/prisma/schema.prisma",
    "keys": "node scripts/check-keys.mjs",
    "repo-keys": "node scripts/repo-token-keys.mjs",
    "secrets": "node scripts/set-secrets.mjs",
    "prod:db": "node scripts/prod-db.mjs",
    "dodo": "node scripts/dodo-keys.mjs",
    "dodo:sync": "node scripts/dodo-sync-packs.mjs",
    "clerk": "node scripts/clerk-keys.mjs",
    "voice-previews": "npm -w runner run voice-previews",
    "dev:all": "node scripts/dev.mjs",
    "dev:web": "npm -w web run dev",
    "sync-skill": "node scripts/sync-skill.mjs",
    "measure": "npm -w runner run measure --",
    "demo": "npm -w web run dev:demo",
    "build:runner": "npm -w runner run build",
    "dev:render": "npm -w render run dev",
    "dev:credits": "npm -w runner run dev:credits --",
    "dev:reset": "node scripts/dev-reset.mjs",
    "deploy:render": "npm -w runner run build && npm -w render run deploy",
    "deploy:web": "node scripts/deploy-web.mjs",
    "music:add": "node scripts/music-add.mjs",
    "openai-key": "node scripts/model-key.mjs openai",
    "anthropic-key": "node scripts/model-key.mjs anthropic",
    "pexels-key": "node scripts/model-key.mjs pexels",
    "pixabay-key": "node scripts/model-key.mjs pixabay"
  }
}
