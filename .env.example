# One .env at the repo root serves local development: `next dev` (web) and `npm run measure` (runner).
# In production nothing is read from this file. Secrets live in Cloudflare (see README "Deploy").

# --- Database ---
# Local Postgres (docker compose up -d) or your Neon connection string. Used by `npm run db:push`,
# by `next dev` without Cloudflare bindings, and to create the Hyperdrive config.
DATABASE_URL=postgresql://launchreel:launchreel@localhost:5433/launchreel

# --- Web app ---
# Public values are baked in at build time.
# Local dev URL. In production this is https://hyped.video (set it as a build variable in CI).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secrets for local development. In production: `npx wrangler secret put <NAME>` inside web/.
# Clerk keys go in web/.env.local: run `clerk init --app <your app id>` inside web/ and it writes them there.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode until Dodo approves your business, then live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Product IDs of the three one-time credit packs in Dodo: Starter, Creator, Pro (contents and prices: PACKS in packages/core/src/pricing.ts)
DODO_PRODUCT_STARTER=
DODO_PRODUCT_CREATOR=
DODO_PRODUCT_PRO=
# Comma-separated Clerk user IDs allowed to see /dashboard/admin
ADMIN_USER_IDS=
# Public key browsers use to encrypt private-repo tokens. Create local dev keys with: npm run repo-keys -- --local
# (that also writes the matching private key to render/.dev.vars). Production: npm run repo-keys -- --production
REPO_TOKEN_PUBLIC_KEY=

# --- Local cost benchmark only (npm run measure) ---
# In production the model keys live only on the render Worker (`npx wrangler secret put ANTHROPIC_API_KEY`
# and `OPENAI_API_KEY` inside render/) and never enter a container. Engines, models, effort and cost caps
# are vars in render/wrangler.jsonc (STANDARD_* and STUDIO_*: one engine per quality tier).
# Which engine the benchmark runs: claude (Claude Agent SDK) or openai (Codex CLI)
ENGINE=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-6-sol
CLAUDE_EFFORT=medium
MAX_COST_PER_JOB_USD=8
MAX_TURNS=150

# Local testing only: extra credits for new sign-ups in `next dev` (never used in production).
DEV_SIGNUP_CREDITS=50
# Local testing only: how `next dev` starts renders on the local render Worker. The same DEV_START_TOKEN
# goes in render/.dev.vars. Any random string works.
DEV_RENDER_URL=http://127.0.0.1:8787
DEV_START_TOKEN=
